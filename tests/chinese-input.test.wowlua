import test, beforeEach, expect from "wowlua:test"
import * as mock from "wowlua:mock"

-- These tests load the complete addon and Blizzard UI in the emulator.
-- The tools/test_*.lua scripts remain the isolated Lua 5.1 regression suite.
local function keyboard(): any
    return _G.ControllerKeyboard
end

local function typeCode(code: string)
    local ck = keyboard()
    for letter in code:gmatch(".") do
        ck:TypeChar(letter)
    end
end

@beforeEach
local function openKeyboard()
    local ck = keyboard()
    expect(ck ~= nil).toBe(true)
    expect(ck.db ~= nil).toBe(true)
    ck.Guide:SetSeen()
    if ck.Config:IsOpen() then ck.Config:Close("test") end
    if ck:IsOpen() then ck:Close("test") end
    ck:SetChineseInput("ziranma")
    ck:SetInputMethod("stick")
    ck:OpenStandalone()
    ck.frame:ClearAllPoints()
    ck.frame:SetPoint("TOP", UIParent, "TOP", 0, -40)
    ck:PositionSendButton()
end

@test("Chinese keyboard opens in the emulated client")
local function opens()
    local ck = keyboard()
    expect(ck.frame).toBeShown()
    expect(ck.frame.imeBar).toBeShown()
    expect(ck:GetText()).toBe("")
end

@test("touch candidate commits Chinese without sending")
local function touchCandidate()
    local ck = keyboard()
    typeCode("nihk")
    expect(ck.ChineseIME:GetCode()).toBe("nihk")
    expect(ck:GetText()).toBe("")
    expect(ck.state.suggestions[1]).toBe("你好")
    mock.click(ck.frame.sugg[1])
    expect(ck:GetText()).toBe("你好")
    expect(ck.ChineseIME:GetCode()).toBe("")
    expect(ck.frame).toBeShown()
end

@test("gamepad A confirms a candidate before sending")
local function gamepadConfirm()
    local ck = keyboard()
    typeCode("nihk")
    mock.pressKey("PAD1")
    expect(ck:GetText()).toBe("你好")
    expect(ck.ChineseIME:GetCode()).toBe("")
    expect(ck.frame).toBeShown()
    expect(ck.sendButton:GetAttribute("macrotext")).toBe("")
end

@test("gamepad B cancels code and retains committed text")
local function gamepadCancel()
    local ck = keyboard()
    ck:SetText("队伍")
    typeCode("ni")
    mock.pressKey("PAD2")
    expect(ck:GetText()).toBe("队伍")
    expect(ck.ChineseIME:GetCode()).toBe("")
    expect(ck.frame).toBeShown()
end

@test("touch English toggle preserves literal letters")
local function englishToggle()
    local ck = keyboard()
    typeCode("raid")
    mock.click(ck.frame.imeToggle)
    expect(ck.db.settings.chineseLatin).toBe(true)
    expect(ck:GetText()).toBe("raid")
    expect(ck.ChineseIME:GetCode()).toBe("")
end

@test("Chinese input screenshot")
local function screenshot()
    local ck = keyboard()
    typeCode("nihk")
    expect(ck.frame).toBeShown()
    expect(ck.frame.sugg[1]).toBeShown()
    mock.screenshot("chinese-input", ck.frame)
end
